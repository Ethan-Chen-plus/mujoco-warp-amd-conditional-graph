@@ -67,4 +67,37 @@ THE SOFTWARE.
 #endif  // !defined(__HIPCC_RTC__)
 #include <hip/hip_vector_types.h>
 
+// HIPRTC does not include hip_runtime_api.h, but the experimental device setter
+// still needs the handle type when conditional helper kernels are compiled.
+#ifndef HIP_GRAPH_CONDITIONAL_HANDLE_DEFINED
+#define HIP_GRAPH_CONDITIONAL_HANDLE_DEFINED 1
+typedef unsigned long long hipGraphConditionalHandle;
+#endif
+#ifndef HIP_GRAPH_CONDITIONAL_EXT
+#define HIP_GRAPH_CONDITIONAL_EXT 1
+#endif
+
+/**
+ * Writes the device-resident value used by an experimental conditional graph node.
+ *
+ * HIPRTC supplies its own generated runtime header.  The Warp conditional helper
+ * kernels define their setter locally, so exporting this inline helper into the
+ * HIPRTC generated header would create an ABI/type dependency before the custom
+ * runtime declarations are visible.
+ */
+#if !defined(__HIPCC_RTC__)
+#if defined(__HIP_DEVICE_COMPILE__)
+__host__ __device__ __forceinline__ void hipGraphSetConditional(hipGraphConditionalHandle handle,
+                                                                unsigned int value) {
+  atomicExch(reinterpret_cast<unsigned int*>(handle), value);
+}
+#else
+__host__ __device__ __forceinline__ void hipGraphSetConditional(hipGraphConditionalHandle handle,
+                                                                unsigned int value) {
+  (void)handle;
+  (void)value;
+}
+#endif
+#endif
+
 #endif
