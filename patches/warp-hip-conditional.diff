+def is_conditional_graph_emulated() -> bool:
+    """Return whether the opt-in HIP device-gated conditional backend is enabled.
+
+    HIP releases used by the AMD target do not provide ``hipGraphConditionalHandle``.
+    MuJoCo-Warp's solver can nevertheless capture one fixed-length graph whose
+    kernels skip work after their device-resident convergence flags are set.  This
+    helper reports that explicit compatibility mode without conflating it with a
+    native HIP conditional graph node.
+    """
+    if runtime is None:
+        init()
+    return runtime.is_hip and os.environ.get("WP_HIP_CONDITIONAL_EMULATION", "0") == "1"
+
