+// ================================================================================================
+hipError_t GraphExec::EnqueueConditionalGraph(hip::Stream* launch_stream) {
+  if (launch_stream == nullptr) {
+    return hipErrorInvalidValue;
+  }
+
+  // Conditional graphs cannot use the AQL packet fast path.  For the current HIP
+  // prototype we keep the graph single-stream and dispatch its already computed
+  // topological order directly.  This avoids recursive traversal of long Warp
+  // solver graphs while preserving graph-node ordering and body execution.
+  for (auto node : topoOrder_) {
+    if (node == nullptr) {
+      return hipErrorInvalidValue;
+    }
+    if (ConditionalGraphDebugEnabled()) {
+      std::fprintf(stderr, "[conditional-debug] linear-node-before node=%p type=%d id=%d capture=%d\n",
+                   static_cast<void*>(node), static_cast<int>(node->GetType()), node->GetID(),
+                   node->GraphCaptureEnabled() ? 1 : 0);
+    }
+    node->SetStream(launch_stream);
+    // Use the node's assigned queue for both command creation and enqueue. Memory
+    // graph nodes depend on this queue identity to bind their VM map/unmap event
+    // to the same execution stream as the following memset/kernel nodes.
+    hip::Stream* node_stream = node->GetQueue();
+    if (node_stream == nullptr) {
+      return hipErrorInvalidValue;
+    }
+    hipError_t status = node->CreateCommand(node_stream);
+    if (ConditionalGraphDebugEnabled()) {
+      std::fprintf(stderr, "[conditional-debug] linear-node-created node=%p type=%d id=%d status=%d commands=%zu\n",
+                   static_cast<void*>(node), static_cast<int>(node->GetType()), node->GetID(),
+                   static_cast<int>(status), node->GetCommands().size());
+    }
+    if (status != hipSuccess) {
+      return status;
+    }
+    // Match the ordinary dependency-aware graph path: EnqueueCommands() drops
+    // the node's construction reference, so retain each command until the
+    // current conditional launch has submitted all nodes.
+    std::vector<amd::Command*> retained_commands;
+    for (auto command : node->GetCommands()) {
+      if (command != nullptr) {
+        command->retain();
+        retained_commands.push_back(command);
+      }
+    }
+    node->EnqueueCommands(node_stream);
+    for (auto command : retained_commands) {
+      command->release();
+    }
+    if (ConditionalGraphDebugEnabled()) {
+      std::fprintf(stderr, "[conditional-debug] linear-node-enqueued node=%p type=%d id=%d\n",
+                   static_cast<void*>(node), static_cast<int>(node->GetType()), node->GetID());
+    }
+  }
+  return hipSuccess;
+}
